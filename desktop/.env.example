# intelligence.7mit 6 Desktop — variabel lingkungan (semuanya OPSIONAL).
#
# API key penyedia AI TIDAK diatur di sini. Masukkan lewat Pengaturan → Penyedia AI;
# key disimpan terenkripsi oleh OS (Keychain / DPAPI / libsecret) di proses utama
# dan tidak pernah dikirim ke UI. Jangan commit berkas .env.

# Jalur Chrome/Chromium/Edge kustom untuk mode Web (Playwright). Default: Chromium bawaan Playwright, lalu Chrome, lalu Edge.
# IT7_BROWSER_PATH=/usr/bin/google-chrome

# --- Hanya untuk build rilis (CI) -----------------------------------------------
# Code signing Windows (sertifikat .pfx/.p12 dalam base64 atau URL) — tanpa ini installer TIDAK bertanda tangan.
# CSC_LINK=
# CSC_KEY_PASSWORD=
# Code signing + notarisasi macOS (akun Apple Developer resmi).
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=
# Token publikasi GitHub Releases (untuk auto-update)
# GH_TOKEN=

# --- Hanya untuk pengujian otomatis (diabaikan pada build terpasang) ---------------
# IT7_E2E=1
# IT7_APP_EXE=/path/ke/binary/terpasang
